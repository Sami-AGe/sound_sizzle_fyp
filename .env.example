GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here
FAL_KEY=your_fal_api_key_here
HF_PROVIDER=replicate
TEXT_TO_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium
IMAGE_TO_IMAGE_MODEL=black-forest-labs/FLUX.1-Kontext-dev

# ── ComfyUI Local Generation (Alternative to HF Replicate) ─────
USE_COMFYUI=false                    # true = use local ComfyUI instead of HF API
COMFYUI_HOST=http://127.0.0.1:8188   # local ComfyUI REST API endpoint
COMFYUI_MODEL=meinmix_v12Final       # checkpoint filename in ComfyUI models/Stable-diffusion/
WHISPER_MODEL_SIZE=base
OUTPUT_DIR=./temp
MAX_AUDIO_DURATION=30
MAX_FRAMES=15
GENERATION_MODE=fast
